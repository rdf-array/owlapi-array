<!--

Tests parsing of data union of.

-->
<rdf:RDF xmlns="http://www.semanticweb.org/owlapi/test#"
     xml:base="http://www.semanticweb.org/owlapi/test"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#">


    <owl:DatatypeProperty rdf:about="#p">
       <rdfs:range>
           <rdfs:Datatype>
               <owl:unionOf rdf:parseType="Collection">
                   <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                   <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#float"/>
               </owl:unionOf>
           </rdfs:Datatype>
       </rdfs:range>
    </owl:DatatypeProperty>

</rdf:RDF>
